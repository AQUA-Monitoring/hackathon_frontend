# Exemplo de variáveis de ambiente para desenvolvimento
# Copie este arquivo para .env e ajuste conforme seu ambiente

# ============================================
# API Backend (obrigatório)
# ============================================
VITE_API_URL=https://aquaapi.fabricadesoftware.ifc.edu.br

# ============================================
# Proxy e HLS (opcional para desenvolvimento)
# ============================================
# Origem do HLS usada para reescrita via /hls em desenvolvimento
# Exemplo: http://192.168.7.10:8000
VITE_HLS_TARGET=

# Alvo genérico de proxy (opcional)
VITE_PROXY_TARGET=

# ============================================
# Firebase Configuration (obrigatório para PWA/Messaging)
# ============================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Mapbox (obrigatório para mapas)
# ============================================
VITE_MAPBOX_API_KEY=your-mapbox-access-token
